# Copy to .env for local development. index.ts loads this file; Render supplies real
# environment variables in production and never reads this file.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/receipt-scanner.db

# Required, no default.
APP_PASSWORD=change-me-min-8-chars
SESSION_SECRET=change-me-min-32-characters-long
MOONSHOT_API_KEY=

KIMI_MODEL=kimi-k2.6
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_THINKING=disabled
KIMI_TIMEOUT_MS=120000

MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=info
TZ=Europe/Oslo

# Used by start.sh and litestream.yml (ADR-0011); only needed for the Docker/Render
# deployment set up in T21, not for local development.
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

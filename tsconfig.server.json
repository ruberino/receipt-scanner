{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "src/server/**/*",
    "src/shared/**/*",
    "test/server/**/*",
    "test/shared/**/*",
    "test/helpers/**/*",
    "eval/**/*",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}

# Environment for local development. Copy to .env and fill in the required values.
# src/server/index.ts loads .env; Render supplies real environment variables in production.
# See docs/architecture.md section 11 for the full description of each variable.

# development | production. production enables Secure cookies and serves the built client.
NODE_ENV=development

# Listen port. The Dockerfile sets this to 8080.
PORT=3000

# Listen address.
HOST=0.0.0.0

# SQLite file path. The Dockerfile sets this to /data/receipt-scanner.db.
DATABASE_PATH=./data/receipt-scanner.db

# Required. Shared household password, at least 8 characters.
APP_PASSWORD=

# Required. HMAC key for the auth cookie, at least 32 characters (e.g. `openssl rand -hex 32`).
# Rotating it logs everyone out.
SESSION_SECRET=

# Which LLM provider reads receipts (extraction and matching): kimi | grok (ADR-0015).
LLM_PROVIDER=kimi

# Which LLM provider makes the AI list proposal (Foreslå med AI): kimi | grok, defaults to
# LLM_PROVIDER when unset (ADR-0017).
LLM_PROVIDER_PROPOSE=

# Retries for a failed LLM call before giving up, applied to whichever provider is active. Explicit
# rather than the OpenAI SDK's default of 2: an unresponsive call retried twice, each retry taking
# the full timeout, can block the queue for several times *_TIMEOUT_MS before the receipt fails.
LLM_MAX_RETRIES=0

# Required when kimi is selected by LLM_PROVIDER or LLM_PROVIDER_PROPOSE. Moonshot AI API key.
# Every extraction, matching and proposal call costs money.
MOONSHOT_API_KEY=

# Kimi model, base URL, thinking mode (enabled | disabled) and request timeout (used by whichever
# provider is active).
KIMI_MODEL=kimi-k2.6
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_THINKING=disabled
KIMI_TIMEOUT_MS=120000

# Required when grok is selected by LLM_PROVIDER or LLM_PROVIDER_PROPOSE. xAI API key. Every
# extraction, matching and proposal call costs money.
XAI_API_KEY=

# Grok model and base URL (ADR-0015).
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# Largest accepted receipt upload in bytes (10 MB).
MAX_UPLOAD_BYTES=10485760

# pino log level.
LOG_LEVEL=info

# Time zone used for log timestamps; "today" is always computed in Europe/Oslo regardless.
TZ=Europe/Oslo

# Litestream replication target. Read by start.sh and litestream.yml, and LITESTREAM_BUCKET
# also by the app itself, to report `replication: 'on' | 'off'` from GET /api/health (T21).
# Without LITESTREAM_BUCKET the app runs without replication.
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
